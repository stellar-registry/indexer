# Testnet pipeline parameters, consumed by goldsky/scripts/render.sh.
# Values substituted into goldsky/*/index.template.yaml.

# Suffix for pipeline names (registry-<NETWORK>-v1, contract-lifecycle-<NETWORK>).
NETWORK=testnet

# Goldsky dataset prefix: <DATASET_PREFIX>.events, <DATASET_PREFIX>.ledger_entries.
DATASET_PREFIX=stellar_testnet

# First ledger the v1 registry-events pipeline reads from — the ledger
# the root registry contract was deployed in (or earlier).
V1_START_AT=2209577

# First ledger the archive (contract-lifecycle) pipeline reads from.
# Kept earlier than V1_START_AT so wasm uploads and deploys that precede
# the first registry event are still captured.
ARCHIVE_START_AT=2200000

# Root registry contract — the emitter whose `sub_reg` events seed the
# subregistry membership set (v1 transform_3).
ROOT_REGISTRY=CAAXJETKPYAATU4HVVQUTE2FFBULNFGZNEOC3MS635U5K3GZLAY2HI4M

# Goldsky secret holding the hosted-Postgres URL for this network's
# database. Each network MUST point at its own database: both pipelines
# write to the fixed schemas `v1` and `archive`, so sharing a database
# across networks would collide.
PG_SECRET_NAME=HOSTED_POSTGRES_CMJD1KI8O0
