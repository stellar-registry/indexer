# Mainnet pipeline parameters, consumed by goldsky/scripts/render.sh.
# Values substituted into goldsky/*/index.template.yaml.
# See testnet.env for what each variable means.

NETWORK=mainnet
DATASET_PREFIX=stellar_mainnet

# Ledger the mainnet root registry was deployed in (CreateContractV2,
# 2026-07-06T20:42:04Z).
V1_START_AT=63359485

# The root registry's UploadContractWasm landed in ledger 63359334
# (2026-07-06T20:27:29Z) — stellar-cli deploys upload and create in two
# separate transactions. Start one ledger before the upload so the
# archive pipeline captures it regardless of start_at edge semantics.
ARCHIVE_START_AT=63359333

ROOT_REGISTRY=CDU4M3LDIOUJJ5F3YXKJ4EJEP5VPRPG6N2LJ5HOQIMN7MNGL3NS3EGUY

# TODO: provision a Goldsky hosted Postgres for mainnet and put the
# generated secret name here before `turbo apply`. Do NOT reuse the
# testnet secret — the schemas collide (see testnet.env).
PG_SECRET_NAME=HOSTED_POSTGRES_MAINNET_TODO
